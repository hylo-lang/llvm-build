#!/usr/bin/env bash

# Fake llvm-config for tests/test-scripts.sh. The odd whitespace is on purpose. With
# STUB_LLVM_WINDOWS set, it prints libraries the way llvm-config does on Windows.

set -euo pipefail

prefix="$(cd "$(dirname "$0")/.." && pwd)"

case "$*" in
  --version) echo "23.1.0git" ;;
  --prefix) echo "$prefix" ;;
  --libdir) echo "$prefix/lib" ;;
  --includedir) echo "$prefix/include" ;;
  --cxxflags) echo "-I$prefix/include  -std=c++17   -fno-exceptions -fno-rtti -D_GNU_SOURCE" ;;
  "--system-libs --libs core analysis bitwriter passes target all-targets")
    if [ -n "${STUB_LLVM_WINDOWS:-}" ]; then
      printf '%s\n' "$prefix\\lib\\LLVMCore.lib $prefix\\lib\\LLVMSupport.lib" "psapi.lib ntdll.lib"
    else
      printf '%s\n' "-lLLVMCore  -lLLVMSupport" "-lrt -ldl -lm"
    fi ;;
  *) echo "llvm-config stub: unexpected arguments: $*" >&2; exit 1 ;;
esac
