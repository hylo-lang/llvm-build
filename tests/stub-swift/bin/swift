#!/usr/bin/env bash

# Fake swift for tests/test-scripts.sh, with a wasm SDK installed at /sdks/wasm.

if [ "$*" != "sdk configure --show-configuration swift-6.3.2-RELEASE_wasm wasm32-unknown-wasip1" ]; then
  echo "swift stub: unexpected arguments: $*" >&2
  exit 1
fi
cat <<'END'
sdkRootPath: /sdks/wasm/WASI.sdk
swiftResourcesPath: /sdks/wasm/swift.xctoolchain/usr/lib/swift_static
swiftStaticResourcesPath: /sdks/wasm/swift.xctoolchain/usr/lib/swift_static
includeSearchPaths: not set
librarySearchPaths: not set
toolsetPaths: ["/sdks/wasm/toolset.json"]
END
